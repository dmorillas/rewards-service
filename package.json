{
  "name": "rewards-service",
  "version": "1.0.0",
  "main": "lib/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node lib/app.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf lib && rm -rf coverage",
    "db:clean": "rm -f rewards.db && rm -rf drizzle",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-validator": "^7.0.1",
    "nanoid": "^5.1.16",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
